# Copy this file to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
APP_NAME=Restaurant Management System

# Timezone used for "today" in reports
TIMEZONE=Asia/Kolkata

# PostgreSQL (asyncpg driver). Inside Docker the host is "db".
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/restaurant

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Password hashing cost. Higher is slower and safer; keep 12 or more in production.
BCRYPT_ROUNDS=12

# Chatbot (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# WhatsApp (provider not chosen yet: "log" only records messages)
WHATSAPP_PROVIDER=log
# Shared secret the provider must send as X-Webhook-Secret to POST /api/messaging/inbound.
# Leave empty to keep the inbound webhook disabled.
WHATSAPP_WEBHOOK_SECRET=
# Shown to guests when the bot hands a conversation to a human
OWNER_CONTACT=

# Run booking reminders and automatic retention campaigns in the background
SCHEDULER_ENABLED=true

# Host port for the backend container (change if 8000 is already in use)
BACKEND_PORT=8000

# Frontend origin allowed by CORS (comma-separated list is also accepted)
CORS_ORIGINS=["http://localhost:5173"]

# How the WhatsApp bot behaves: messages of history the model sees, most tool-calling rounds per
# guest message, and the most messages one guest may send per hour (0 = no limit)
CHAT_HISTORY_MESSAGES=12
CHAT_MAX_TOOL_ROUNDS=4
CHAT_MAX_MESSAGES_PER_HOUR=30

# Logging: LOG_FORMAT is "text" (readable) or "json" (one JSON object per line)
LOG_LEVEL=INFO
LOG_FORMAT=text
